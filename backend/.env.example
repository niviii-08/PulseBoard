# Copy this file to .env and adjust values for your local environment.
# .env is gitignored — never commit real secrets.

# --- General ---
ENVIRONMENT=development
APP_NAME=PulseBoard
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- API ---
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list, no spaces needed but tolerated.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Proxy trust ---
# Set to true ONLY if this process sits behind a reverse proxy/load
# balancer that you control and that overwrites (not appends to)
# X-Forwarded-For itself. Leaving this false (the safe default) makes
# rate limiting key off the raw socket peer address instead, which a
# client cannot spoof.
TRUST_PROXY_HEADERS=false

# --- Database ---
# Async URL (asyncpg driver) used by the running application and by Alembic.
DATABASE_URL=postgresql+asyncpg://pulseboard:pulseboard@localhost:5432/pulseboard
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
# Separate Redis logical DB (index 1) from the app's own cache/pub-sub
# usage (index 0) so their keys never collide on the same Redis instance.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Social intelligence: AI explanation engine (optional) ---
# Leave unset to use the deterministic template-based explanation
# engine (app/services/explanation_engine.py) -- fully functional with
# no API key. Setting this switches "why is this trending" / sentiment-
# shift summaries over to LLM-generated prose, grounded in the same
# evidence either way.
ANTHROPIC_API_KEY=

# --- Social intelligence: alert thresholds (all optional, shown at defaults) ---
TREND_SCORE_ALERT_THRESHOLD=70.0
SENTIMENT_SHIFT_ALERT_THRESHOLD_PCT_POINTS=25.0
BRAND_RISK_ALERT_THRESHOLD=60.0
MENTION_SPIKE_GROWTH_THRESHOLD_PCT=150.0
CROSS_PLATFORM_SPREAD_MIN_PLATFORMS=3

# --- Social intelligence: optional real data-collector credentials ---
# All optional. Absent -> that collector reports "not_configured" on
# GET /api/v1/sources and is skipped by the ingestion task, rather than
# silently pretending to collect data. NewsCollector (RSS) needs none of
# these -- it works with zero configuration.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
# Comma-separated RSS feed URL templates; {query} is replaced with the
# brand/topic search term at collection time.
NEWS_RSS_FEEDS=https://news.google.com/rss/search?q={query}

# --- Security ---
JWT_SECRET_KEY=changeme-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Testing ---
# Only read by the pytest suite (app/tests/conftest.py). A separate
# database so tests never touch development data.
TEST_DATABASE_URL=postgresql+asyncpg://pulseboard:pulseboard@localhost:5432/pulseboard_test
