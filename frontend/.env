# Base URL for the PulseBoard REST API. Defaults to /api/v1 (see
# src/lib/api/client.ts) if unset, which works when the frontend is
# served behind the same origin/proxy as the backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL for the real-time event feed (backend Phase 8).
VITE_WS_URL=ws://localhost:8000/api/v1/ws/status
